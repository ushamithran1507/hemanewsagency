# HEMA NEWS AGENCY - Environment Configuration
# Backend API Configuration

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production_min_32_chars
JWT_EXPIRATION=7d

# Database Configuration (Using JSON files + Google Drive)
DATA_DIR=./data
USE_GOOGLE_DRIVE=true

# Google Drive Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Gmail Configuration (for notifications)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# UPI Configuration
UPI_ID=agency@okhdfcbank
UPI_NAME=HEMA%20NEWS%20AGENCY
UPI_TRANSACTION_REF_PREFIX=HNA

# API Keys
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Session
SESSION_SECRET=your_session_secret_key_change_this_in_production

# Admin Configuration
ADMIN_EMAIL=admin@hemanewsagency.com
ADMIN_PHONE=9876543210

# Feature Flags
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_WHATSAPP_INTEGRATION=false

# Cache Configuration
CACHE_TTL=3600
ENABLE_CACHE=true

# Maintenance
BACKUP_INTERVAL=86400
AUTO_SYNC_GDRIVE=true
SYNC_INTERVAL=3600
